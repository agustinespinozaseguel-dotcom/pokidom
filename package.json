import React, { useState, useEffect } from "react";
import { View, Text, FlatList, StyleSheet } from "react-native";

export default function RankingScreen() {
  const [players, setPlayers] = useState([]);

  useEffect(() => {
    // ranking falso pero listo para online después
    const data = [
      { name: "You", wins: 10 },
      { name: "Ash", wins: 8 },
      { name: "CPU Master", wins: 15 },
      { name: "Red", wins: 12 },
    ];

    setPlayers(data.sort((a, b) => b.wins - a.wins));
  }, []);

  return (
    <View style={styles.container}>
      <Text style={styles.title}>🏆 Ranking</Text>

      <FlatList
        data={players}
        keyExtractor={(item) => item.name}
        renderItem={({ item, index }) => (
          <View style={styles.card}>
            <Text style={styles.text}>
              #{index + 1} {item.name} - {item.wins} wins
            </Text>
          </View>
        )}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: "#0f172a", padding: 10 },
  title: { color: "#38bdf8", fontSize: 24, marginBottom: 10 },
  card: { backgroundColor: "#1e293b", padding: 10, marginVertical: 5 },
  text: { color: "white" },
});